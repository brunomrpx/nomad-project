---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { items } from "../data/items";
import { sortItemsByStatus } from "../lib/items";
import ItemCard from "../components/ItemCard.astro";
import planeSvg from "../assets/brand/aviao.svg?raw";

const sortedItems = sortItemsByStatus(items);
---

<BaseLayout title={site.title}>
  <section class="cover">
    <div class="cover-content">
      <h1 class="cover-wordmark">
        <span class="names">
          <span class="name">Bruno</span>
          <span class="name">Bruna</span>
        </span>
        <span class="amp" aria-hidden="true">&amp;</span>
      </h1>
      <div class="cover-copy">
        <p>{site.intro}</p>
        <p>{site.ctaLine}</p>
      </div>
    </div>
    <div class="cover-plane" aria-hidden="true" set:html={planeSvg} />
    <div class="cover-footer">
      <a href="#items" class="scroll-btn" aria-label="Ver itens à venda">
        <svg class="chevrons" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6 8l6 6 6-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <path
            d="M6 14l6 6 6-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
    </div>
  </section>
  <main id="items" class="items-section">
    <div class="grid">
      {sortedItems.map((item) => <ItemCard item={item} />)}
    </div>
  </main>
  <style>
    .cover {
      position: relative;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      background: var(--color-bg);
      padding: 2rem 1.5rem 6rem;
    }
    .cover-content {
      position: relative;
      z-index: 2;
      max-width: 640px;
    }
    .cover-wordmark {
      position: relative;
      display: inline-flex;
      align-items: center;
      margin: 0 0 2rem;
    }
    .names {
      display: flex;
      flex-direction: column;
      line-height: 0.85;
    }
    .name {
      font-family: var(--font-poster);
      font-weight: 900;
      font-size: clamp(2.5rem, 11.71vw, 7.5rem);
      color: var(--color-pink);
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }
    .amp {
      font-family: var(--font-display);
      font-style: normal;
      font-weight: 500;
      color: var(--color-paper);
      font-size: clamp(3.5rem, 26.45vw, 16.9375rem);
      line-height: 1;
      margin-left: 1px;
    }
    .cover-copy p {
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(232, 228, 211, 0.85);
      max-width: 46ch;
      margin: 0 0 1rem;
    }
    .cover-copy p:last-child {
      margin-bottom: 0;
    }
    .cover-plane {
      position: absolute;
      top: -3rem;
      right: 0;
      width: 62%;
      aspect-ratio: 873 / 565.3;
      z-index: 1;
      display: none;
      color: var(--color-paper);
    }
    .cover-plane :global(svg) {
      display: block;
      width: 100%;
      height: 100%;
    }
    @media (min-width: 768px) {
      .cover-plane {
        display: block;
      }
    }
    .cover-footer {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
    }
    .cover-footer::before {
      content: "";
      display: block;
      height: 0.9rem;
      background: var(--color-pink);
    }
    .scroll-btn {
      position: absolute;
      left: 50%;
      bottom: 1.9rem;
      transform: translateX(-50%);
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 50%;
      background: var(--color-pink);
      color: var(--color-paper);
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
      animation: bounce 2s ease-in-out infinite;
    }
    .scroll-btn:hover {
      filter: brightness(1.08);
    }
    .chevrons {
      width: 1.4rem;
      height: 1.4rem;
    }
    @keyframes bounce {
      0%,
      100% {
        bottom: 1.9rem;
      }
      50% {
        bottom: 0.9rem;
      }
    }
    .items-section {
      background: var(--color-paper);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 1.5rem 4rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    @media (min-width: 640px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 1024px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
      }
    }
  </style>
</BaseLayout>

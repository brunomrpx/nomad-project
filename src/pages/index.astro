---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { items } from "../data/items";
import { sortItemsByStatus } from "../lib/items";
import ItemCard from "../components/ItemCard.astro";

const sortedItems = sortItemsByStatus(items);
---

<BaseLayout title={site.title}>
  <header class="hero">
    <div class="hero-inner">
      <h1 class="wordmark">Bruno <span class="amp">&amp;</span> Bruna</h1>
      <p class="subtitle">{site.title}</p>
      <p class="intro">{site.intro}</p>
      <a
        class="gate-cta"
        href={`https://wa.me/${site.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Falar no WhatsApp <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </header>
  <main class="grid">
    {sortedItems.map((item) => <ItemCard item={item} />)}
  </main>
  <style>
    .hero {
      padding: 4rem 1.5rem 3rem;
      border-bottom: 1px solid var(--color-line);
      text-align: center;
      background: var(--color-bg);
    }
    .hero-inner {
      max-width: 640px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .wordmark {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3.25rem);
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: 0.01em;
      color: var(--color-paper);
      margin: 0 0 0.75rem;
    }
    .wordmark .amp {
      font-style: italic;
      font-weight: 500;
      color: var(--color-amber);
      padding: 0 0.15em;
    }
    .subtitle {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-amber);
      margin: 0 0 1.5rem;
    }
    .hero .intro {
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(243, 233, 210, 0.8);
      max-width: 48ch;
      margin: 0 0 2rem;
    }
    .gate-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      letter-spacing: 0.04em;
      font-weight: 600;
      background: var(--color-green);
      color: #08210f;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      text-decoration: none;
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }
    .gate-cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(63, 163, 94, 0.35);
    }
    .gate-cta span {
      display: inline-block;
      transition: transform 0.15s ease;
    }
    .gate-cta:hover span {
      transform: translateX(3px);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 1.5rem 4rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    @media (min-width: 640px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 1024px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
      }
    }
  </style>
</BaseLayout>
